{
  "name": "modulo",
  "version": "0.7.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 1430",
    "test": "vitest run",
    "cover:engine": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "verify": "npm run typecheck && npm run cover:engine && npm run build && npm run test:e2e",
    "docs:check": "node scripts/docs-check.mjs",
    "desktop:probe": "node scripts/desktop-probe.mjs",
    "release:ledger": "node scripts/release-manifest.mjs",
    "release:ledger:update": "node scripts/release-manifest.mjs --update",
    "engine:build": "npm run build --workspace @modulo/engine",
    "engine:pack": "npm pack --workspace @modulo/engine",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.e2e.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.2.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.3",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.12"
  },
  "dependencies": {
    "@modulo/engine": "*",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "lucide-vue-next": "^0.577.0"
  }
}
