{
  "name": "modulo",
  "version": "0.1.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 1430",
    "test": "vitest run",
    "cover:engine": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "verify": "npm run typecheck && npm run cover:engine && npm run build && npm run test:e2e",
    "desktop:probe": "node scripts/desktop-probe.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.e2e.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^3.2.4",
    "fast-check": "^4.2.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.40"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "lucide-vue-next": "^0.577.0"
  }
}
