{
  "name": "@modulo/engine",
  "version": "0.4.0",
  "description": "Modulo 的布局投影引擎：12 列逻辑版面按容器宽度投影成 12/8/6/4/1 档，纯函数、零框架依赖",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Levango7/Modulo.git",
    "directory": "packages/engine"
  },
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  }
}
